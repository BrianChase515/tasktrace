{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tasktrace/tasktrace/schema/trace.schema.json",
  "title": "tasktrace trace",
  "description": "One recorded task demonstration, compiled for an AI agent to understand and replicate.",
  "type": "object",
  "required": ["schema", "task", "parameters", "outline", "steps", "success_criteria"],
  "anyOf": [
    { "required": ["automation_synthesis_guidance"] },
    { "required": ["replay_guidance"] }
  ],
  "properties": {
    "schema": { "const": "tasktrace/0.1" },
    "generator": { "type": "string" },
    "task": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "goal": { "type": "string", "description": "What the person said the task is for." },
        "recorded_at": { "type": "string" },
        "duration_s": { "type": "number" },
        "notes": { "type": "array", "items": { "type": "string" } },
        "gaps": {
          "type": "array",
          "description": "Periods not recorded (paused, or an excluded app such as a password manager was in front).",
          "items": { "type": "object" }
        },
        "runs_compared": { "type": "integer", "minimum": 1 }
      }
    },
    "environment": {
      "type": "object",
      "properties": {
        "os": { "type": "string" },
        "machine": { "type": "string" },
        "screens": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "frame": { "$ref": "#/$defs/rect" },
              "scale": { "type": "number" }
            }
          }
        },
        "apps_used": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "name": { "type": "string" }, "bundle_id": { "type": "string" } }
          }
        }
      }
    },
    "automation_synthesis_guidance": {
      "type": "string",
      "description": "Default. Tells the consuming AI to compile this demonstration into a generalized automation script (loops, wildcard matchers, pruned detours) rather than replaying it click for click."
    },
    "replay_guidance": {
      "type": "string",
      "description": "Literal step-by-step instructions, for the local executor loop. Written when --guidance replay|both."
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "step", "status"],
        "properties": {
          "name": { "type": "string" },
          "kind": { "enum": ["text", "date", "number", "currency", "email", "url", "secret"] },
          "example": { "type": "string" },
          "step": { "type": "integer" },
          "status": {
            "enum": ["guess", "confirmed"],
            "description": "guess = inferred from one run; confirmed = value differed between compared runs."
          },
          "seen": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "outline": {
      "type": "array",
      "description": "One line per step. The cheapest way to read the task.",
      "items": { "type": "string" }
    },
    "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } },
    "success_criteria": {
      "type": "object",
      "properties": {
        "final_app": { "type": "string" },
        "final_window": { "type": "string" },
        "last_effect": { "$ref": "#/$defs/effect" },
        "done_marker": { "type": "object" },
        "visible_text": { "type": "array", "items": { "type": "string" } }
      }
    },
    "redactions": {
      "type": "object",
      "properties": {
        "total": { "type": "integer" },
        "by_kind": { "type": "object", "additionalProperties": { "type": "integer" } }
      }
    }
  },
  "$defs": {
    "rect": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
    "xy": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
    "step": {
      "type": "object",
      "required": ["id", "t_ms", "action", "describe"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "t_ms": { "type": "integer", "minimum": 0 },
        "action": {
          "enum": ["click", "double_click", "triple_click", "right_click", "drag", "type", "key", "hotkey", "scroll", "open_app"]
        },
        "describe": { "type": "string" },
        "app": { "type": "string" },
        "window": { "type": "string" },
        "intent": { "type": "string", "description": "The person's own note about why this step happens." },
        "text": { "type": "string" },
        "secret": { "type": "boolean" },
        "param": { "type": "string" },
        "constant": { "type": "boolean" },
        "optional": { "type": "boolean" },
        "keys": { "type": "string" },
        "times": { "type": "integer" },
        "scroll": { "type": "object", "properties": { "dx": { "type": "number" }, "dy": { "type": "number" } } },
        "target": {
          "type": "object",
          "description": "Locators, most robust first: element, ocr_label, rel_xy, abs_xy.",
          "properties": {
            "element": {
              "type": "object",
              "properties": {
                "role": { "type": "string" },
                "subrole": { "type": "string" },
                "title": { "type": "string" },
                "description": { "type": "string" },
                "placeholder": { "type": "string" },
                "identifier": { "type": "string" },
                "value": { "type": "string" },
                "help": { "type": "string" }
              }
            },
            "path": { "type": "string" },
            "ocr_label": { "type": "string" },
            "field_hint": { "type": "string", "description": "For typing into an unlabeled field: the question clicked just before." },
            "rel_xy": { "$ref": "#/$defs/xy" },
            "in_element_xy": { "$ref": "#/$defs/xy" },
            "abs_xy": { "$ref": "#/$defs/xy" },
            "to_xy": { "$ref": "#/$defs/xy" },
            "crop": { "type": "string" },
            "crop_rect": { "$ref": "#/$defs/rect", "description": "Screen region the crop covers: the element's own bounds, padded, so OCR reads whole words." },
            "thumbnail": { "type": "string" }
          }
        },
        "container_context": { "$ref": "#/$defs/container_context" },
        "effect": { "$ref": "#/$defs/effect" }
      }
    },
    "container_context": {
      "type": "object",
      "description": "What the click happened inside: the list row, or the modal/form and its fields. Lets a model write a loop over rows, or fill a form it can see whole, instead of repeating one recorded position.",
      "properties": {
        "kind": { "enum": ["list", "modal", "list_in_modal"] },
        "container": {
          "type": "object",
          "properties": {
            "role": { "type": "string" },
            "subrole": { "type": "string" },
            "role_description": { "type": "string" },
            "title": { "type": "string" }
          }
        },
        "list_item_index": { "type": "integer", "minimum": 0, "description": "0-based child index of the row that was clicked." },
        "total_items": { "type": "integer", "minimum": 0, "description": "Immediate children of the list at record time." },
        "item_text_summary": { "type": "string", "description": "All the text in that row: the whole card, not the fragment under the pointer." },
        "item_controls": { "type": "array", "items": { "$ref": "#/$defs/control" } },
        "interactive_siblings": {
          "type": "array",
          "description": "Every interactive control visible in the same modal or form, including ones the person never touched.",
          "items": { "$ref": "#/$defs/control" }
        },
        "progress": { "type": "string" },
        "modal": { "type": "object", "description": "Present when a list sits inside a modal: the modal's own context." }
      }
    },
    "control": {
      "type": "object",
      "properties": {
        "role": { "type": "string" },
        "title": { "type": "string" },
        "value": { "type": "string" },
        "placeholder": { "type": "string" }
      }
    },
    "effect": {
      "type": "object",
      "description": "What changed on screen as a result of the step.",
      "properties": {
        "opened": { "type": "array", "items": { "type": "string" } },
        "closed": { "type": "array", "items": { "type": "string" } },
        "retitled": {
          "type": "array",
          "items": { "type": "object", "properties": { "from": { "type": "string" }, "to": { "type": "string" } } }
        },
        "focused": { "type": "string" },
        "app": { "type": "string" },
        "dialog_opened": {
          "type": "array",
          "description": "A modal or dialog that appeared inside the page, with no window opening.",
          "items": { "type": "string" }
        },
        "dialog_closed": { "type": "array", "items": { "type": "string" } },
        "toggled": {
          "type": "array",
          "description": "Checkboxes, radio buttons or switches whose value changed as a result of the step.",
          "items": {
            "type": "object",
            "properties": {
              "element": { "type": "string" },
              "from": { "type": "string" },
              "to": { "type": "string" }
            }
          }
        },
        "progress": {
          "type": "object",
          "description": "A progress indicator that advanced, e.g. 20 percent -> 40 percent.",
          "properties": { "from": { "type": "string" }, "to": { "type": "string" } }
        },
        "settle_ms": { "type": "integer" },
        "screenshot": { "type": "string" }
      }
    }
  }
}
